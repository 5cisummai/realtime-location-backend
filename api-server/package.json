{
  "name": "api-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hono API server with Better Auth, Drizzle, Postgres, and Redis",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "smoke:realtime": "bun scripts/smoke-realtime.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:studio": "bunx drizzle-kit studio",
    "auth:generate": "bunx auth@latest generate --config ./src/auth.ts --output ./src/db/schema/auth.ts --yes"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.10",
    "@better-auth/redis-storage": "^1.7.10",
    "@hono/zod-openapi": "^1.6.3",
    "@mapbox/polyline": "^1.2.1",
    "@scalar/hono-api-reference": "^0.12.12",
    "better-auth": "^1.7.10",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "ioredis": "^5.11.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
